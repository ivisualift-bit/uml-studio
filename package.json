{
  "name": "uml-studio",
  "private": true,
  "version": "0.1.0",
  "description": "UML Studio — a local-first semantic UML modeling application (web + Tauri desktop).",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "fflate": "0.8.3",
    "immer": "11.2.3",
    "jspdf": "4.2.1",
    "lucide-react": "1.60.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg2pdf.js": "2.8.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "java-parser": "3.0.1",
    "jsdom": "28",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
